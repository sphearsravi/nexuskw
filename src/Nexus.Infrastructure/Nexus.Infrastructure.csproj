<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Nexus.Application\Nexus.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />

    <!-- Stage C (delivery). PDFsharp is MIT; PdfPig reads but cannot write, iText is AGPL. -->
    <PackageReference Include="PdfSharp" Version="6.1.1" />

    <!-- Stage D (email). MailKit rather than System.Net.Mail.SmtpClient, which Microsoft
         documents as not recommended for new development; MimeKit comes with it and gets
         the UTF-8 encoding of Arabic right, which is the part that silently produces
         "????" when hand-rolled. -->
    <PackageReference Include="MailKit" Version="4.18.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The six categories and twenty titles carried over from the demo. -->
    <EmbeddedResource Include="Persistence\SeedData\catalogue.json" />
  </ItemGroup>

